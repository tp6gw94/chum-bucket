{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["docs/**/*.sketch.ts", "tests/**"],
  "plugins": ["typescript", "unicorn", "oxc", "eslint"],
  "jsPlugins": [
    {
      "name": "@stylistic",
      "specifier": "@stylistic/eslint-plugin"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": ["error", "all"],
    "@stylistic/padding-line-between-statements": [
      "error",
      {
        "blankLine": "always",
        "prev": "*",
        "next": "return"
      },
      {
        "blankLine": "always",
        "prev": "*",
        "next": "block-like"
      },
      {
        "blankLine": "always",
        "prev": "block-like",
        "next": "*"
      }
    ],

    "@stylistic/lines-between-class-members": [
      "error",
      "always",
      {
        "exceptAfterSingleLine": false
      }
    ],

    "@stylistic/no-multiple-empty-lines": [
      "error",
      {
        "max": 1,
        "maxBOF": 0,
        "maxEOF": 0
      }
    ],

    "complexity": ["warn", 15],
    "max-depth": ["warn", 3],
    "max-lines-per-function": [
      "warn",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
