{
  "name": "chum-bucket",
  "type": "module",
  "scripts": {
    "generate": "openui generate src/library.ts --spec --out src/generated/spec.json",
    "prevdev": "pnpm run generate",
    "dev": "concurrently \"vite\" \"tsx watch server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "typecheck": "tsc",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:compaction-offline": "node scripts/check-compaction-offline.mjs",
    "check:openui": "tsx scripts/check-openui-parse.ts",
    "check:thread-browser": "node scripts/check-thread-browser.mjs",
    "prebuild": "pnpm run generate",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "lint": "oxlint && fallow",
    "lint:fix": "oxlint --fix-dangerously",
    "mcp:atlassian": "tsx scripts/mcp-atlassian.ts",
    "dev:thread-browser": "vite --config scripts/thread-browser-vite.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dbos-inc/dbos-sdk": "^5.0.2",
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@hono/node-server": "^2.1.1",
    "@openuidev/lang-core": "^0.3.0",
    "@openuidev/react-headless": "^0.16.2",
    "@openuidev/react-lang": "^0.3.0",
    "@openuidev/react-ui": "^0.16.2",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/ai": "^0.58.0",
    "@tanstack/ai-code-mode": "0.4.13",
    "@tanstack/ai-isolate-quickjs": "0.3.1",
    "@tanstack/ai-mcp": "0.4.3",
    "@tanstack/ai-openai": "^0.23.1",
    "@tanstack/ai-react": "^0.27.3",
    "@tanstack/react-ai-devtools": "^0.2.71",
    "@tanstack/react-devtools": "^0.10.12",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.2",
    "dotenv": "^18.0.2",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "lucide-react": "^1.47.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@openuidev/cli": "^0.4.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.31.0",
    "oxc-transform-react": "^0.151.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.84.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
